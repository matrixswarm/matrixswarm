<?php
$this->headTitle('Download MatrixSwarm');
$manifestPath = '/sites/matrixswarm/shared/downloads/latest.json';
$release = null;
if (is_readable($manifestPath)) {
    $data = json_decode(file_get_contents($manifestPath, false, null, 0, 16384), true);
    if (is_array($data) && ($data['schema_version'] ?? null) === 1
        && preg_match('/^[0-9a-f]{40}$/D', $data['commit'] ?? '')
        && preg_match('/^\d{4}\.\d{2}\.\d{2}-[0-9a-f]{40}$/D', $data['version'] ?? '')
        && ($data['filename'] ?? '') === 'matrixswarm-' . $data['version'] . '.zip'
        && substr($data['version'], -40) === $data['commit']
        && preg_match('/^[0-9a-f]{64}$/D', $data['sha256'] ?? '')
        && preg_match('/^[0-9a-f]{128}$/D', $data['sha512'] ?? '')
        && is_int($data['bytes'] ?? null) && $data['bytes'] > 0) {
        $release = $data;
    }
}
$escape = static fn($text) => htmlspecialchars((string) $text, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$download = $release ? '/downloads/' . rawurlencode($release['filename']) : null;
?>
