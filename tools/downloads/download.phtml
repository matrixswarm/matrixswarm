        <div class="ms-store-actions">
            <?php if ($release): ?>
                <a class="ms-store-button" href="<?= $escape($download) ?>">Download versioned source ZIP</a>
            <?php endif; ?>
            <a class="ms-store-secondary" href="https://github.com/matrixswarm/matrixswarm" rel="noopener noreferrer">View on GitHub &nearr;</a>
        </div>
        <?php if ($release): ?>
            <p>Source snapshot <?= $escape(substr($release['version'], 0, 10)) ?>
                &middot; commit <a href="https://github.com/matrixswarm/matrixswarm/commit/<?= $escape($release['commit']) ?>"><?= $escape(substr($release['commit'], 0, 12)) ?></a>
                &middot; <?= $escape(number_format($release['bytes'] / 1048576, 1)) ?> MiB</p>
        <?php else: ?>
            <p>The versioned download is being prepared. The source repository is available above.</p>
        <?php endif; ?>
    </header>
