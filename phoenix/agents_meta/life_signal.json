{
  "name": "life_signal",
  "description": "Provisional — QC testing needed. Watches configured sources for reported events and alerts through a service role.",
  "keywords": [
    "news",
    "celebrity",
    "watch",
    "alerts",
    "wikipedia",
    "rss"
  ],
  "groups": [
    "monitoring",
    "communication"
  ],
  "universal_id": "life-signal-1",
  "constraints": [
    {
      "packet_signing": {
        "in": true,
        "out": true
      }
    },
    {
      "persistent_state": null
    }
  ],
  "config": {
    "oracle_role": "hive.oracle",
    "alert_role": "hive.alert",
    "source_presets": [
      {
        "name": "Wikipedia biography",
        "kind": "wikipedia",
        "url": "https://en.wikipedia.org/wiki/",
        "description": "Live edits for a chosen English Wikipedia article"
      },
      {
        "name": "GDELT news search",
        "kind": "rss",
        "url": "https://api.gdeltproject.org/api/v2/doc/doc?query=YOUR_SEARCH&mode=artlist&format=rss&timespan=24h&sort=datedesc",
        "description": "News search feed; replace YOUR_SEARCH and check current service limits"
      }
    ],
    "ui": {
      "agent_tree": {
        "emoji": "📡"
      },
      "panel": [
        "life_signal.life_signal"
      ]
    },
    "service-manager": [
      {
        "role": [
          "hive.life_signal.get@cmd_get_sources",
          "hive.life_signal.update@cmd_update_sources",
          "hive.life_signal.resume@cmd_resume_source",
          "hive.life_signal.retry@cmd_retry_source"
        ],
        "scope": [
          "parent",
          "any"
        ]
      }
    ]
  }
}
