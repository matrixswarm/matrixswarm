{
    "universal_id": "cdn_dozer",
    "name": "cdn_dozer",
    "description": "Uploads files to the configured CDN and verifies completed uploads.",
    "keywords": [
        "cdn",
        "files",
        "content",
        "upload"
    ],
    "groups": [
        "automation"
    ],
    "constraints": [
        {
            "cdn": {}
        },
        {
            "mysql": {}
        }
    ],
    "config": {
        "ui": {
            "agent_tree": {"emoji": "🚀"},
            "panel": [
                "cdn_dozer.cdn_dozer"
            ]
        },
        "cdn": {
            "poll_interval": 60
        },
        "service-manager": [
            {
                "role": [
                    "hive.cdn_dozer.push_file@cmd_push_file",
                    "hive.cdn_dozer.verify_upload@cmd_verify_upload"
                ],
                "scope": ["parent", "any"]
            }
        ]
    }
}