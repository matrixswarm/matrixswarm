{
    "name": "matrix_email_egress",
    "description": "Sends encrypted swarm replies and alerts to active Phoenix sessions through SMTP.",
    "keywords": [
        "email",
        "smtp",
        "transport",
        "egress",
        "rpc",
        "alerts"
    ],
    "groups": [
        "communication"
    ],
    "universal_id": "matrix-email-egress",
    "constraints": [
        {
            "packet_signing": {
                "in": true,
                "out": true
            }
        },
        {
            "email_egress": {"inject_in_connection": 1}
        }
    ],
    "config": {
        "ui": {
            "agent_tree": {
                "emoji": "\ud83d\udef0\ufe0f"
            },
            "panel": [
                "matrix_email_egress.matrix_email_egress"
            ]

        },
        "service-manager": [
            {
                "role": [
                    "hive.alert@cmd_send_alert_msg",
                    "hive.swarm_feed.alert@cmd_send_alert_msg",
                    "hive.rpc@cmd_rpc_route",
                    "matrix_email_egress.toggle_perimeter@cmd_toggle_perimeter",
                    "hive.toggle_perimeter@cmd_toggle_perimeter",
                    "matrix_email_egress.status@cmd_status"
                ],
                "scope": [
                    "parent",
                    "any"
                ],
                "priority": {
                    "hive.log.delivery": -1,
                    "hive.proxy.route": 5,
                    "default": 10
                }
            }
        ]
    }
}