{
    "name": "log_health",
    "description": "Reads bounded log samples, publishes signed snapshots and requests Oracle analysis.",
    "keywords": [
        "logs",
        "analysis",
        "ai",
        "alerts"
    ],
    "groups": [
        "monitoring",
        "ai"
    ],
    "universal_id": "log-health",
    "constraints": [{"packet_signing": {"in": true, "out": true}}],
    "config": {
        "ui": {
            "panel": ["log_health.log_health"],
            "agent_tree": {
                "emoji": "\ud83e\uddfe"
            }
        },
        "log_path": "/var/log/httpd/error_log",
        "service_name": "apache.error_log",
        "severity_rules": {
            "CRITICAL": [
                "segfault"
            ],
            "WARNING": [
                "error",
                "client denied"
            ]
        },
        "report_to_role": "hive.forensics.data_feed",
        "oracle_role": "hive.oracle",
        "service-manager": [{"role": [
            "hive.log_health.snapshot@cmd_snapshot",
            "hive.log_health.analyze@cmd_analyze"
        ]}]
    }
}
