{
    "name": "rsync_boy",
    "universal_id": "rsync-boy-1",
    "constraints": [
        {
            "packet_signing": {
                "in": true,
                "out": true
            }
        },
        {
            "persistent_state": null
        },
        {
            "ssh": null
        },
        {
            "mysql": null
        }
    ],
    "config": {
        "launch_stagger_sec": 5,
        "retry_interval_sec": 900,
        "ui": {
            "agent_tree": {
                "emoji": "\ud83d\udcbe"
            },
            "panel": [
                "rsync_boy.rsync_boy"
            ]
        },
        "service-manager": [
            {
                "role": [
                    "hive.rsync_boy.get_jobs@cmd_retrieve_jobs",
                    "hive.rsync_boy.update_jobs@cmd_update_jobs",
                    "hive.rsync_boy.execute_job@cmd_execute_job"
                ],
                "scope": [
                    "parent",
                    "any"
                ]
            }
        ]
    }
}
