{
    "name": "harvester",
    "description": "Discovers local or SSH-reachable swarms using matrixd and reports their inventory and state.",
    "keywords": [
        "ssh",
        "inventory",
        "swarm",
        "monitoring"
    ],
    "groups": [
        "monitoring"
    ],
    "universal_id": "harvester-1",
    "constraints": [
        {
            "packet_signing": {
                "in": true,
                "out": true
            }
        },
        {
            "symmetric_encryption": {
                "type": "aes"
            }
        },
        {
            "harvester_assignment": null
        }
    ],
    "config": {
        "enabled": false,
        "check_interval_sec": 30,
        "matrixd_timeout_sec": 60,
        "alert_to_role": "hive.alert",
        "targets": [],
        "ui": {
            "agent_tree": {
                "emoji": "🌾"
            }
        }
    }
}
