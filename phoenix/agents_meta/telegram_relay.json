{
    "name": "telegram_relay",
    "universal_id": "telegram-bot-father-2",
    "constraints": [
        {
            "telegram": null
        },
        {
            "packet_signing": {
                "in": true,
                "out": true
            }
        }
    ],
    "config": {
        "alerts_enabled": true,
        "encrypt_alerts": false,
        "packet_ttl": 3600,
        "ui": {
            "agent_tree": {
                "emoji": "\ud83d\udce1"
            },
            "panel": [
                "telegram_relay.telegram_relay"
            ]
        },
        "service-manager": [
            {
                "role": [
                    "comm",
                    "comm.security",
                    "comm.*",
                    "hive.alert@cmd_send_alert_msg"
                ],
                "scope": [
                    "parent",
                    "any"
                ],
                "auth": {
                    "sig": true
                },
                "priority": 10,
                "exclusive": false
            }
        ]
    }
}