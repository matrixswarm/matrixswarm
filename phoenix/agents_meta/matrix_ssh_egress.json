{
    "name": "matrix_ssh_egress",
    "universal_id": "matrix-ssh-egress",
    "description": "Returns encrypted RPC replies and swarm alerts to Phoenix through a private, session-scoped outbox read over pinned SSH. No inbound port on the Phoenix workstation is required.",
    "keywords": ["ssh", "egress", "transport", "rpc", "alerts"],
    "groups": ["communication"],
    "connection": {"channel": "payload.reception"},
    "constraints": [
        {"matrix_ssh_egress": {"inject_in_connection": 1, "deployment_only": 1}},
        {"packet_signing": {"in": true, "out": true}}
    ],
    "config": {
        "ssh_mode": "persistent",
        "poll_interval": 1,
        "batch_limit": 32,
        "packet_ttl": 300,
        "session_timeout": 180,
        "max_pending_packets": 1024,
        "lockdown_state": false,
        "lockdown_time": 0,
        "ui": {
            "agent_tree": {"emoji": "📤"},
            "panel": ["matrix_ssh_egress.matrix_ssh_egress"]
        },
        "service-manager": [{
            "role": ["hive.rpc@cmd_rpc_route", "hive.alert@cmd_send_alert_msg", "hive.swarm_feed.alert@cmd_send_alert_msg", "matrix_ssh_egress.status@cmd_status", "matrix_ssh_egress.toggle_perimeter@cmd_toggle_perimeter", "hive.toggle_perimeter@cmd_toggle_perimeter"],
            "scope": ["parent", "any"]
        }]
    }
}
